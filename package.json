{
  "name": "cozy-acres",
  "private": true,
  "version": "1.32.1",
  "type": "module",
  "description": "Cozy Acres - a mobile-first 3D farming and village builder that runs in the browser",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:app": "tsc --noEmit && CAP_BUILD=1 vite build && cap sync android",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fetch-assets": "bash scripts/fetch-assets.sh",
    "assets": "node scripts/build-assets.mjs",
    "validate-data": "node scripts/validate-data.mjs",
    "simulate-economy": "node scripts/simulate-economy.mjs",
    "test:regression": "vite build && node tests/regression.mjs",
    "test:perf": "vite build && (npx vite preview --port 4173 --strictPort >/dev/null 2>&1 &) && sleep 3 && node tools/stress-decor.mjs http://localhost:4173/play/ 720 --budget 520 && node tools/stress-home.mjs http://localhost:4173/play/ --budget 120"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@supabase/supabase-js": "^2.117.2",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@types/howler": "^2.2.13",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "uisfx": "^0.4.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
